@ProductCatalogService_HostAddress = http://localhost:5009
@SkuId = 2a85c8a7-996d-4bd4-a1cb-3f3b82fbcb53

POST {{ProductCatalogService_HostAddress}}/products/
Content-Type: application/json

{
  "sellerId": "d8017639-4f75-4701-9915-f5757b6234a8",
  "skuId": "{{SkuId}}",
  "title": "Smartphone demo",
  "category": "electronics",
  "price": 1299.90,
  "dimensions": {
    "heightCm": 10,
    "widthCm": 20,
    "lengthCm": 30
  },
  "weightKg": 1.25,
  "isFragile": false,
  "isRestricted": false
}

###

GET {{ProductCatalogService_HostAddress}}/products/{{SkuId}}
Accept: application/json

###

POST {{ProductCatalogService_HostAddress}}/products/physical-info/batch
Content-Type: application/json

{
  "skuIds": [
    "{{SkuId}}",
    "74039986-a240-4cf8-9b2f-947d950f6cc2"
  ]
}

###

PUT {{ProductCatalogService_HostAddress}}/products/{{SkuId}}/physical-info
Content-Type: application/json

{
  "weightKg": 1.50,
  "dimensions": {
    "heightCm": 11,
    "widthCm": 21,
    "lengthCm": 31
  },
  "isFragile": true,
  "isRestricted": false
}

###

PATCH {{ProductCatalogService_HostAddress}}/products/{{SkuId}}/status
Content-Type: application/json

{
  "status": "Paused"
}
